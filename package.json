{
  "name": "status-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 tsx --watch src/config/load-env.js",
    "start": "tsx src/config/load-env.js",
    "test": "cross-env NODE_NO_WARNINGS=1  vitest",
    "test:unit": "cross-env NODE_NO_WARNINGS=1 VITE_TEST_TYPE=unit vitest run tests/unit",
    "test:integration": "cross-env NODE_NO_WARNINGS=1 vitest run tests/integration",
    "test:watch": "cross-env NODE_NO_WARNINGS=1 vitest --watch",
    "coverage": "cross-env NODE_NO_WARNINGS=1 vitest run --coverage --coverage.reporter=text",
    "coverage:ci": "cross-env NODE_NO_WARNINGS=1 vitest run --coverage --coverage.reporter=lcov",
    "test:ui": "cross-env NODE_NO_WARNINGS=1 vitest --coverage.enabled=true --ui",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "format": "eslint . --fix --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "populate": "node scripts/populate.js",
    "bench": "cross-env NODE_NO_WARNINGS=1 vitest bench",
    "clean-logs": "node scripts/clean-logs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "1.9.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-validator": "7.2.1",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "mongoose": "8.14.3",
    "openai": "4.98.0",
    "pg": "8.16.0",
    "pg-mem": "3.0.5",
    "sequelize": "6.37.7",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.19.4",
    "uuid": "11.1.0",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.26.0",
    "@evilmartians/lefthook": "1.11.13",
    "@stylistic/eslint-plugin-js": "4.2.0",
    "@vitest/coverage-istanbul": "3.1.3",
    "@vitest/ui": "3.1.3",
    "commitlint": "19.8.1",
    "cross-env": "7.0.3",
    "eslint": "9.26.0",
    "globals": "16.1.0",
    "ioredis-mock": "8.9.0",
    "mongodb-memory-server": "10.1.4",
    "pre-commit": "1.2.2",
    "supertest": "7.1.1",
    "vitest": "3.1.3"
  }
}
