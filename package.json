    "test": "cross-env NODE_NO_WARNINGS=1  vitest",
    "test:unit": "cross-env NODE_NO_WARNINGS=1 VITE_TEST_TYPE=unit vitest run tests/unit",
    "test:integration": "cross-env NODE_NO_WARNINGS=1 vitest run tests/integration",
    "test:watch": "cross-env NODE_NO_WARNINGS=1 vitest --watch",
    "coverage": "cross-env NODE_NO_WARNINGS=1 vitest run --coverage --coverage.reporter=text",
    "coverage:ci": "cross-env NODE_NO_WARNINGS=1 vitest run --coverage --coverage.reporter=lcov",
    "test:ui": "cross-env NODE_NO_WARNINGS=1 vitest --coverage.enabled=true --ui",
    "lint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "format": "eslint . --fix --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "populate": "node scripts/populate.js",
    "clean-logs": "node scripts/clean-logs.js"
  },
